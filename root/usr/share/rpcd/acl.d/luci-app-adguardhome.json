{
	"luci-app-adguardhome": {
		"description": "Grant UCI and file access for luci-app-adguardhome",
		"read": {
			"file": {
				"/usr/share/AdGuardHome/addhost.sh": [ "exec" ],
				"/usr/share/AdGuardHome/AdGuardHome_template.yaml": [ "read" ],
				"/usr/share/AdGuardHome/getsyslog.sh": [ "exec" ],
				"/usr/share/AdGuardHome/gfw2adg.sh": [ "exec" ],
				"/usr/share/AdGuardHome/gfw2adg.lua": [ "exec" ],
				"/usr/share/AdGuardHome/gfwipset2adg.sh": [ "exec" ],
				"/usr/share/AdGuardHome/update_core.sh": [ "exec" ],
				"/usr/share/AdGuardHome/agh_version.sh": [ "exec" ],
				"/usr/share/AdGuardHome/agh_check.sh": [ "exec" ],
				"/usr/share/AdGuardHome/waitnet.sh": [ "exec" ],
				"/usr/share/AdGuardHome/watchconfig.sh": [ "exec" ],
				"/etc/init.d/AdGuardHome": [ "exec" ],
				"/etc/init.d/dnsmasq": [ "exec" ],
				"/etc/init.d/firewall": [ "exec" ],
				"/etc/init.d/cron": [ "exec" ],
				"/usr/bin/AdGuardHome/AdGuardHome": [ "exec" ],
				"/tmp/AdGuardHome/AdGuardHome": [ "exec" ],
				"/etc/AdGuardHome.yaml": [ "read" ],
				"/tmp/AdGuardHome.log": [ "read" ],
				"/tmp/AdGuardHome_update.log": [ "read" ],
				"/tmp/AdGuardHometmpconfig.yaml": [ "read" ],
				"/tmp/AdGuardHometest.log": [ "read" ],
				"/var/run/AdG_redir": [ "read" ],
				"/var/run/AdG_syslog": [ "read" ],
				"/var/run/AdG_update_error": [ "read" ]
			},
			"uci": [ "AdGuardHome" ]
		},
		"write": {
			"file": {
				"/etc/AdGuardHome.yaml": [ "write" ],
				"/tmp/AdGuardHome.log": [ "write" ],
				"/tmp/AdGuardHome_update.log": [ "write" ],
				"/tmp/AdGuardHometmpconfig.yaml": [ "write" ],
				"/tmp/AdGuardHometest.log": [ "write" ],
				"/var/run/AdG_redir": [ "write" ],
				"/var/run/AdG_syslog": [ "write" ],
				"/var/run/AdG_update_error": [ "write" ]
			},
			"uci": [ "AdGuardHome" ]
		}
	}
}
